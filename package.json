{
  "name": "claude-review-action",
  "version": "0.1.0",
  "private": true,
  "description": "Configurable AI code review on pull requests, powered by the Anthropic Messages API.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "actions",
    "code-review",
    "anthropic",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^0.115.0",
    "minimatch": "^10.2.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vercel/ncc": "^0.44.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
